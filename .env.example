# Copy to .env and edit. Every line is optional; the defaults are shown.

# web app
# H3C_HOST=127.0.0.1          # 0.0.0.0 to open it to your network
# H3C_PORT=7880
# H3C_DATA=./data             # uploads, jobs and logs
# H3C_LIBRARY=./examples/library

# ComfyUI (must be running; the app copies inputs into its input folder, so it needs the folder too)
# H3C_COMFY_URL=http://127.0.0.1:8188
# H3C_COMFY_DIR=~/ComfyUI

# Qwen3.8-27B through llama.cpp (the app starts and stops llama-server itself)
# H3C_LLAMA_SERVER=~/llama.cpp/build/bin/llama-server
# H3C_LLM_MODEL=~/models/qwen38/Qwen3.8-27B-UD-IQ4_XS.gguf
# H3C_LLM_MMPROJ=~/models/qwen38/mmproj-Q8_0.gguf
# H3C_LLM_PORT=8091
# H3C_LLM_CTX=16384

# Python interpreters (one venv can do everything; split them if your packages clash)
# H3C_PY=./.venv/bin/python               # the app (FastAPI, OpenCV)
# H3C_PY_SAM3=./.venv/bin/python          # torch + transformers with SAM 3
# H3C_PY_MOGE=./.venv/bin/python          # torch + MoGe-2 (Depth Map tool only)
# H3C_REMOVER_DIR=~/minimax-remover       # MiniMax-Remover checkout (object fixes)
# H3C_PY_REMOVER=~/minimax-remover/.venv/bin/python
